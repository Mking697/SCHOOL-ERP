// School ERP — Phase 0/1 schema
// On-premise single-tenant per install (each school = its own DB instance),
// but we keep a School row as the one-tenant settings/profile record, and a
// License table as a stub for future multi-school licensing (Phase 9).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  SCHOOL_ADMIN
  HR
  TEACHER
  ACCOUNTANT
  PARENT
  STUDENT
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License?
}

model License {
  id          String   @id @default(cuid())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String   @unique
  licenseKey  String   @unique
  plan        String   @default("standard")
  activatedAt DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher Teacher?
  parent  Parent?
  staff   Staff?
}

model ClassLevel {
  id        String    @id @default(cuid())
  name      String // e.g. "Class 10"
  sections  Section[]
  feeStructures FeeStructure[]
  exams     Exam[]
  createdAt DateTime  @default(now())
}

model Section {
  id        String      @id @default(cuid())
  name      String // e.g. "A"
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId String
  students  Student[]
  timetable TimetableEntry[]
  homework  Homework[]
  virtualClasses VirtualClass[]

  @@unique([classLevelId, name])
}

model Teacher {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String @unique
  phone   String?
}

model Parent {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String    @unique
  phone    String?
  students Student[]
}

model Student {
  id            String    @id @default(cuid())
  admissionNo   String    @unique
  firstName     String
  lastName      String
  dob           DateTime?
  gender        String?
  section       Section?  @relation(fields: [sectionId], references: [id])
  sectionId     String?
  parent        Parent?   @relation(fields: [parentId], references: [id])
  parentId      String?
  route         TransportRoute? @relation(fields: [routeId], references: [id])
  routeId       String?
  guardianName  String?
  guardianPhone String?
  address       String?
  photoUrl      String?
  isActive      Boolean   @default(true)
  admittedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Student/Parent portal login -- shared credential (Admission No +
  // password), set/reset by a Super Admin/School Admin from the student
  // detail page. Null means the portal login isn't activated yet.
  portalPasswordHash String?

  attendance Attendance[]
  invoices   Invoice[]
  marks      Mark[]
  bookIssues BookIssue[]
  healthRecord HealthRecord?
  behaviorRecords BehaviorRecord[]
  achievements    Achievement[]
}

model Enquiry {
  id           String   @id @default(cuid())
  studentName  String
  guardianName String?
  phone        String
  email        String?
  classApplied String?
  status       String   @default("NEW") // NEW | FOLLOW_UP | ADMITTED | CLOSED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  date      DateTime
  status    String // PRESENT | ABSENT | LATE | HALF_DAY
  markedBy  String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model Subject {
  id        String           @id @default(cuid())
  name      String           @unique
  code      String?
  createdAt DateTime         @default(now())
  timetable TimetableEntry[]
  homework  Homework[]
  examSubjects ExamSubject[]
  virtualClasses VirtualClass[]
}

model TimetableEntry {
  id           String   @id @default(cuid())
  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId    String
  dayOfWeek    Int // 0=Sunday .. 6=Saturday
  periodNumber Int
  subject      Subject? @relation(fields: [subjectId], references: [id])
  subjectId    String?
  // teacherId is the source of truth once set (lets a teacher's own
  // dashboard reliably query "my periods today"); teacherName is kept as a
  // free-text fallback for entries created before this field existed, or
  // when no matching Staff record exists yet.
  teacher      Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId    String?
  teacherName  String?
  startTime    String? // "09:00"
  endTime      String? // "09:45"
  createdAt    DateTime @default(now())

  @@unique([sectionId, dayOfWeek, periodNumber])
}

// A school-wide period/bell schedule (typically 8 periods + a lunch break),
// configured once and reused as the column headers for every section's
// timetable grid, and as the source of "what time does period N start/end"
// for the teacher dashboard's live current/next period widget.
model Period {
  id           String   @id @default(cuid())
  periodNumber Int      @unique // 1..8 for teaching periods; use a distinct
  // number (e.g. 0) for a lunch break slot so it sorts first/can be placed
  // anywhere without colliding with a real teaching period.
  label        String // "Period 1", "Lunch Break"
  startTime    String // "09:00"
  endTime      String // "09:45"
  isBreak      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Accounting (Phase 1: Chart of Accounts + double-entry Journal) ---
// Every money movement becomes a balanced Journal Entry (sum of debits ==
// sum of credits across its lines) against this Chart of Accounts. P&L,
// Balance Sheet, Trial Balance, Receivables/Payables Ageing and the Petty
// Cash triple-column book are all DERIVED from this one ledger, not
// separate data stores.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  isSystem  Boolean     @default(false) // seeded default account, not user-deletable
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  journalLines JournalLine[]
  bills        Bill[]
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      DateTime
  narration String
  reference String? // e.g. "Invoice #2026-0001", "Payslip 2026-10", "Manual"
  createdBy String? // staff name/email, free text (no FK -- keep ledger even if staff is removed)
  createdAt DateTime @default(now())

  lines       JournalLine[]
  bill        Bill?
  billPayment BillPayment?
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId String
  account        Account      @relation(fields: [accountId], references: [id])
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)

  @@index([accountId])
}

// --- Vendor Payables (Phase 2) ---
// A Bill always books two journal lines at creation time (Dr the chosen
// Expense/Asset account, Cr Vendor Payables) and each BillPayment books
// another two (Dr Vendor Payables, Cr Cash/Bank) -- the ledger stays the
// single source of truth, Bill/BillPayment are just a vendor-friendly view
// over it.
model Vendor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  bills Bill[]
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Bill {
  id               String       @id @default(cuid())
  vendor           Vendor       @relation(fields: [vendorId], references: [id])
  vendorId         String
  billNumber       String?
  billDate         DateTime
  dueDate          DateTime
  description      String
  amount           Decimal      @db.Decimal(12, 2)
  expenseAccount   Account      @relation(fields: [expenseAccountId], references: [id])
  expenseAccountId String
  status           BillStatus   @default(UNPAID)
  journalEntry     JournalEntry @relation(fields: [journalEntryId], references: [id])
  journalEntryId   String       @unique
  createdAt        DateTime     @default(now())

  // Receipt/invoice proof -- stored the same way the school logo/student
  // photo are (a data: URL string), capped client+server side so this
  // never becomes a filesystem/S3 dependency for a self-hosted product.
  attachmentUrl  String?
  attachmentName String?

  payments BillPayment[]
}

model BillPayment {
  id             String       @id @default(cuid())
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId         String
  amount         Decimal      @db.Decimal(12, 2)
  method         String // CASH | BANK_TRANSFER | CHEQUE
  paidAt         DateTime     @default(now())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  journalEntryId String       @unique
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@unique([date])
}

model FeeHead {
  id          String          @id @default(cuid())
  name        String          @unique // e.g. "Tuition Fee", "Transport Fee"
  createdAt   DateTime        @default(now())
  structures  FeeStructure[]
}

model FeeStructure {
  id           String     @id @default(cuid())
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId String
  feeHead      FeeHead    @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  feeHeadId    String
  amount       Decimal    @db.Decimal(10, 2)
  frequency    String     @default("TERM") // ONE_TIME | MONTHLY | TERM | ANNUAL
  createdAt    DateTime   @default(now())

  @@unique([classLevelId, feeHeadId, frequency])
}

model Invoice {
  id           String    @id @default(cuid())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  title        String
  totalAmount  Decimal   @db.Decimal(10, 2)
  dueDate      DateTime
  status       String    @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE | CANCELLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2)
}

model Payment {
  id                String   @id @default(cuid())
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String
  amount            Decimal  @db.Decimal(10, 2)
  method            String // CASH | BANK_TRANSFER | CHEQUE | ONLINE
  razorpayOrderId   String?
  razorpayPaymentId String?
  recordedBy        String?
  paidAt            DateTime @default(now())
}

model Homework {
  id          String   @id @default(cuid())
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  title       String
  description String?
  dueDate     DateTime
  createdBy   String?
  createdAt   DateTime @default(now())
}

model Exam {
  id           String        @id @default(cuid())
  title        String
  classLevel   ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime      @default(now())

  subjects ExamSubject[]
}

model ExamSubject {
  id        String   @id @default(cuid())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId    String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  maxMarks  Int      @default(100)
  examDate  DateTime?

  marks Mark[]

  @@unique([examId, subjectId])
}

model Mark {
  id            String      @id @default(cuid())
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  examSubjectId String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  marksObtained Decimal     @db.Decimal(6, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examSubjectId, studentId])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  designation  String // e.g. "Teacher", "Accountant", "Librarian", "Admin"
  department   String?
  phone        String?
  email        String?
  joiningDate  DateTime @default(now())
  salary       Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional login account for the Staff & Admin app, set up separately by an
  // admin from the staff record (not created automatically on Add Staff).
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @unique

  leaveRequests   LeaveRequest[]
  workAssignments WorkAssignment[]
  timetableEntries TimetableEntry[]
  attendance       StaffAttendance[]
  payslips         Payslip[]
}

// Daily staff/teacher attendance -- same shape as the existing Student
// Attendance model, marked by HR (policy/reports) or by a Teacher for their
// own record via the dashboard.
model StaffAttendance {
  id        String   @id @default(cuid())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  date      DateTime
  status    String // PRESENT | ABSENT | LATE | HALF_DAY
  markedBy  String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
}

// One row per staff member per calendar month ("2026-10"). Generated by
// Accountant/Principal from Staff.salary, then marked paid when settled --
// this is the first real payment-history record; Staff.salary itself stays
// just the configured monthly figure, not a ledger.
model Payslip {
  id        String    @id @default(cuid())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  month     String // "2026-10"
  amount    Decimal   @db.Decimal(10, 2)
  status    String    @default("PENDING") // PENDING | PAID
  paidOn    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([staffId, month])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  appliedAt  DateTime  @default(now())
  decidedBy  String?
  decidedAt  DateTime?
}

model WorkAssignment {
  id          String    @id @default(cuid())
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  createdAt   DateTime  @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL | TEACHERS | PARENTS | STUDENTS
  createdBy String?
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
}

model ServiceRequest {
  id              String    @id @default(cuid())
  raisedByName    String
  raisedByContact String
  subject         String
  description     String?
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
}

model TransportRoute {
  id            String   @id @default(cuid())
  name          String
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  createdAt     DateTime @default(now())

  // Driver App login -- separate from staff/portal auth, same pattern as
  // the student portal: Vehicle Number + Password, activated by an admin.
  driverPasswordHash String?

  // Live GPS -- updated by the Driver App while a trip is in progress.
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?

  stops    Stop[]
  students Student[]
}

model Stop {
  id      String         @id @default(cuid())
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String
  name    String
  order   Int            @default(0)
  lat     Float?
  lng     Float?
}

model Book {
  id               String   @id @default(cuid())
  title            String
  author           String?
  isbn             String?
  totalCopies      Int      @default(1)
  availableCopies  Int      @default(1)
  createdAt        DateTime @default(now())

  issues BookIssue[]
}

model BookIssue {
  id         String    @id @default(cuid())
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("ISSUED") // ISSUED | RETURNED

  @@index([studentId])
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  category  String?
  quantity  Int      @default(0)
  unit      String?
  location  String?
  createdAt DateTime @default(now())
}

model HealthRecord {
  id               String   @id @default(cuid())
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId        String   @unique
  bloodGroup       String?
  allergies        String?
  conditions       String?
  emergencyContact String?
  updatedAt        DateTime @updatedAt
}

model Visitor {
  id            String    @id @default(cuid())
  name          String
  phone         String
  purpose       String
  personToMeet  String?
  checkIn       DateTime  @default(now())
  checkOut      DateTime?
}

model BehaviorRecord {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  type        String // POSITIVE | NEGATIVE
  category    String?
  description String
  recordedBy  String?
  createdAt   DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  title       String
  category    String? // Sports | Academics | Arts | Co-curricular
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model VirtualClass {
  id          String   @id @default(cuid())
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  title       String
  meetingLink String
  scheduledAt DateTime
  createdAt   DateTime @default(now())
}
