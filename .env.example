# Copy to .env and fill in before running. install.ps1 generates this automatically
# for production installs -- this file is only for local development.
#
# NOTE: there is no single DATABASE_URL here on purpose. Some Windows
# endpoint security tools (seen with Avast on this project) silently redact
# "scheme://user:pass@host" shaped text to "***" when written to disk, which
# would corrupt a literal connection-string .env value. So the app builds the
# Postgres connection string in memory from these separate pieces instead
# (see prisma.config.ts / src/lib/db.ts).

# Postgres connection pieces (for local dev, matches docker-compose service)
PGHOST=localhost
PGPORT=5432
PGUSER=school_erp
PGPASSWORD=REPLACE_DB_PW_HERE
PGDATABASE=school_erp

# Auth
JWT_SECRET=REPLACE_WITH_RANDOM_LONG_STRING

# Seed data (OPTIONAL, dev/CI convenience only -- skips the web /setup
# wizard by pre-creating a School + Super Admin on first run. Leave unset
# for real installs; the end user completes setup themselves at /setup).
# SEED_SCHOOL_NAME=My School
# SEED_ADMIN_NAME=Super Admin
# SEED_ADMIN_EMAIL=admin@school.local
# SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Postgres container init vars -- MUST match PGUSER/PGPASSWORD/PGDATABASE above
POSTGRES_USER=school_erp
POSTGRES_PASSWORD=REPLACE_DB_PW_HERE
POSTGRES_DB=school_erp

# App port exposed on the host
APP_PORT=3000

# Razorpay (optional -- only needed for "Pay Online" on fee invoices)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LICENSE_SIGNING_SECRET is intentionally NOT set here. It is baked into the
# Dockerfile as a product-wide constant (same value for every customer
# install), not generated per-install like JWT_SECRET/DB password. For local
# dev only, you can set a throwaway value matching what you pass to
# scripts/generate-license.mjs:
# LICENSE_SIGNING_SECRET=dev-only-value

# Central Vendor/Billing Server (OPTIONAL -- /vendor-server, a separate app
# the vendor deploys once on their own server). If BOTH are set, this
# install checks in with the vendor server and shows a hard paywall with
# instant-unlock Razorpay payment when the subscription lapses. Leave BOTH
# unset for a standalone install with no central billing (the offline
# LICENSE_SIGNING_SECRET system above still works independently).
# VENDOR_SERVER_URL=https://billing.yourcompany.com
# SCHOOL_API_KEY=REPLACE_WITH_THE_KEY_SHOWN_ON_THE_VENDOR_DASHBOARD
